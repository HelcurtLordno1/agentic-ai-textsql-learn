# Ollama may run on Windows while this project runs in WSL.
# Never hard-code this value in source code. Example:
OLLAMA_BASE_URL=http://host-address:11434

# Optional generated-data locations (defaults are relative to PROJECT_ROOT).
# TEXT2SQL_DATA_DIR=/path/to/data
# TEXT2SQL_ARTIFACT_DIR=/path/to/artifacts


# Experimental A1 is opt-in; default remains P6. Use a guarded wrapper for model calls.
# TEXT2SQL_PIPELINE_MODE=a1
# TEXT2SQL_CRITIC_MODE=off
# TEXT2SQL_CRITIC_SHADOW_SAMPLE_RATE=0.1
# TEXT2SQL_REPAIR_FEEDBACK_MODE=grounded
# TEXT2SQL_COMPUTE_POLICY=obligation
# TEXT2SQL_DETERMINISTIC_REPAIR=true
# TEXT2SQL_REPAIRABILITY_ROUTING=true
# V5 mechanical reliability controls (opt-in; see .env.v5.example and docs/v5_reproduction.md).
# TEXT2SQL_RECOVER_EMPTY_RELATIONS=true
# TEXT2SQL_RESOLVE_DERIVED_COLUMNS=true
# TEXT2SQL_A1_MAX_REQUESTS=3
# TEXT2SQL_GENERATION_FORMAT=json
# TEXT2SQL_INPUT_TOKEN_BUDGET=2800
# TEXT2SQL_OUTPUT_TOKEN_BUDGET=768
# For a reviewed specialist: pin installed model name and SHA-256 digest.
# TEXT2SQL_GENERATION_MODEL_DIGEST=<64 hex characters>
