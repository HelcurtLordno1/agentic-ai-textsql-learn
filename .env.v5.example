# Optional V5 application settings. Copy to .env only after model-free checks.
# Change this endpoint for your machine; WSL + Windows Ollama usually uses the WSL gateway.
# The benchmark harness overrides its own backend endpoint and applies the named profile.
OLLAMA_BASE_URL=http://127.0.0.1:11434
TEXT2SQL_PIPELINE_MODE=a1
TEXT2SQL_OLLAMA_MODEL=qwen3:14b-q4_K_M
TEXT2SQL_CRITIC_MODE=repair
TEXT2SQL_CRITIC_SHADOW_SAMPLE_RATE=0
TEXT2SQL_COMPUTE_POLICY=obligation
TEXT2SQL_DETERMINISTIC_REPAIR=true
TEXT2SQL_REPAIRABILITY_ROUTING=true
TEXT2SQL_REPAIR_FEEDBACK_MODE=grounded
TEXT2SQL_RECOVER_EMPTY_RELATIONS=true
TEXT2SQL_RESOLVE_DERIVED_COLUMNS=true
TEXT2SQL_GENERATION_FORMAT=json
TEXT2SQL_A1_MAX_REQUESTS=3
TEXT2SQL_INPUT_TOKEN_BUDGET=2800
TEXT2SQL_OUTPUT_TOKEN_BUDGET=768
TEXT2SQL_OLLAMA_NUM_GPU=0
TEXT2SQL_OLLAMA_NUM_THREAD=8
TEXT2SQL_OLLAMA_NUM_BATCH=64
TEXT2SQL_OLLAMA_SEED=42
TEXT2SQL_RUN_DEADLINE_SECONDS=900
TEXT2SQL_REQUEST_TIMEOUT_SECONDS=300
TEXT2SQL_MONITOR_WINDOWS_HOST=true
# Model requests still require the guarded wrapper. Do not set internal guard markers.
